<!DOCTYPE html><html lang="fa"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-53c5605b-ca99-4025-ac27-87ed07e105db@mhtml.blink" />
  
  <title>🎉 اینترنت رایگان شما آماده‌ست!</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- ایران‌سنس از CDN -->
  <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/font-face.css" rel="stylesheet">
  
</head>
<body>

  <!-- صفحه خوش‌آمدگویی -->
  <div class="welcome hidden" id="welcome">
    <div class="emoji">🌐🎁📶</div>
    <h1>به سایت دریافت اینترنت رایگان خوش آمدید!</h1>
    <p>لطفاً چند لحظه صبر کنید...</p>
  </div>

  <!-- محتوای اصلی بعد از ۳ ثانیه -->
  <div class="main-content" id="main">
    <h1>🎉 دریافت اینترنت رایگان در دو مرحله آسان</h1>

    <!-- مرحله اول -->
    <div class="step" id="step1">
      <div class="step-number">📲 مرحله اول</div>
      <h2>دانلود اپلیکیشن ویژه</h2>
      <p>اپلیکیشن ما را با کلیک روی دکمه زیر دانلود و نصب کنید.</p>
      <button>📥 دانلود اپلیکیشن</button>
    </div>

    <!-- مرحله دوم مخفی -->
    <div class="step hidden" id="step2">
      <div class="step-number">✅ مرحله دوم</div>
      <h2>ورود و دریافت ۳۰ گیگ اینترنت</h2>
      <p>پس از نصب اپلیکیشن، از طریق لینک زیر ثبت‌نام کنید و بسته را دریافت کنید.</p>
      <button>🎁 ورود به سایت دریافت هدیه</button>
    </div>
  </div>

  <!-- مودال اعلان -->
  <div class="modal-overlay" id="modal">
    <div class="modal">
      <h3>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7H2l10-9 10 9h-2z"></path>
        </svg>
        رفیق عزیز!
      </h3>
      <p>
        اول سایت میلی رو وارد شو و ۲۰ گیگ اینترنت هدیه رو دریافت کن،<br>
        بعد اپلیکیشن رو نصب کن و ۲۰ گیگ دیگه رو بگیر!
      </p>
      <button class="close-btn">متوجه شدم</button>
    </div>
  </div>

  


</body></html>
