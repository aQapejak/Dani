@charset "utf-8";

body { font-family: Vazir, Tahoma, sans-serif; margin: 0px; padding: 0px; background: linear-gradient(135deg, rgb(168, 237, 234), rgb(254, 214, 227)); color: rgb(51, 51, 51); direction: rtl; overflow-x: hidden; }

.welcome, .main-content { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; padding: 20px; text-align: center; }

.welcome h1 { font-size: 36px; font-weight: 700; color: rgb(3, 64, 120); animation: 1.2s ease-out 0s 1 normal forwards running fadeIn; }

.emoji { font-size: 72px; margin-bottom: 25px; animation: 1.2s ease-out 0s 1 normal none running popIn; filter: drop-shadow(rgba(0, 0, 0, 0.2) 0px 2px 3px); }

@keyframes popIn { 
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes fadeIn { 
  0% { opacity: 0; transform: translateY(30px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.step { background-color: rgba(255, 255, 255, 0.9); border-radius: 20px; padding: 30px 35px; margin: 20px; max-width: 90%; box-shadow: rgba(3, 64, 120, 0.15) 0px 12px 35px; transition: transform 0.3s, box-shadow 0.3s; }

.step:hover { transform: scale(1.03); box-shadow: rgba(3, 64, 120, 0.25) 0px 20px 50px; }

h2 { color: rgb(3, 105, 161); margin-bottom: 12px; font-weight: 600; font-size: 28px; }

button { padding: 14px 30px; font-size: 18px; cursor: pointer; background: linear-gradient(135deg, rgb(58, 141, 255), rgb(0, 80, 179)); color: white; border: none; border-radius: 12px; margin-top: 20px; box-shadow: rgba(58, 141, 255, 0.6) 0px 8px 18px; transition: background 0.4s, box-shadow 0.4s; font-weight: 700; }

button:hover { background: linear-gradient(135deg, rgb(0, 80, 179), rgb(0, 51, 102)); box-shadow: rgba(0, 80, 179, 0.8) 0px 12px 30px; }

.hidden { display: none; }

.step-number { font-size: 22px; margin-bottom: 15px; color: rgb(85, 85, 85); font-weight: 600; }

.modal-overlay { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.65); display: flex; justify-content: center; align-items: center; z-index: 9999; opacity: 0; pointer-events: none; transition: opacity 0.35s; }

.modal-overlay.active { opacity: 1; pointer-events: auto; }

.modal { background: white; border-radius: 20px; padding: 35px 30px; max-width: 420px; text-align: center; box-shadow: rgba(0, 0, 0, 0.2) 0px 15px 40px; font-size: 20px; color: rgb(34, 34, 34); line-height: 1.6; transform: scale(0.8); opacity: 0; transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1); }

.modal-overlay.active .modal { transform: scale(1); opacity: 1; }

.modal h3 { margin-top: 0px; color: rgb(2, 132, 199); margin-bottom: 20px; font-size: 28px; font-weight: 700; display: flex; justify-content: center; align-items: center; gap: 12px; }

.modal h3 svg { width: 36px; height: 36px; fill: rgb(2, 132, 199); filter: drop-shadow(rgba(0, 0, 0, 0.12) 0px 2px 2px); }

.modal p { margin: 0px auto; max-width: 350px; line-height: 1.7; font-weight: 600; color: rgb(68, 68, 68); }

.modal button.close-btn { margin-top: 30px; background: linear-gradient(135deg, rgb(2, 132, 199), rgb(3, 105, 161)); border: none; padding: 14px 36px; border-radius: 12px; color: white; font-size: 20px; font-weight: 700; cursor: pointer; box-shadow: rgba(2, 132, 199, 0.7) 0px 10px 22px; transition: background 0.4s, box-shadow 0.4s; }

.modal button.close-btn:hover { background: linear-gradient(135deg, rgb(3, 105, 161), rgb(1, 79, 117)); box-shadow: rgba(1, 79, 117, 0.9) 0px 14px 35px; }
